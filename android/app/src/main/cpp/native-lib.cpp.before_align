// SET DEPTH NATIVE WINDOW
// ============================================================================

extern "C" JNIEXPORT void JNICALL
Java_com_hsv2_hsv2_1lite_MainActivity_setDepthNativeWindow(
        JNIEnv* env,
        jobject /* this */,
        jobject surface) {

    if (depthNativeWindow) {

        ANativeWindow_release(
